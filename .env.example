# Local dev Postgres (docker compose up -d). Placeholder credentials, local only.
POSTGRES_USER=visual_arc
POSTGRES_PASSWORD=visual_arc
POSTGRES_DB=visual_arc
# API settings (defaults shown; the API reads the process environment, not this file)
DATABASE_URL=postgresql+psycopg://visual_arc:visual_arc@localhost:5432/visual_arc
# API_DATA_DIR=<repo>/var/data
# Accounts. OAuth is optional: a provider with no id/secret returns 503 and its button is hidden.
# Placeholders only; put real values in your shell/.env, never in git.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public web origin; OAuth callbacks are <WEB_BASE_URL>/api/v1/auth/oauth/<provider>/callback
# WEB_BASE_URL=http://localhost:3000
# AUTH_COOKIE_SECURE=true   # set behind HTTPS (off for localhost)
# SESSION_SECRET=<random>   # signs the short-lived OAuth state cookie; set with >1 worker
# AUTH_RATE_LIMIT_PER_MIN=10
# Web (next.config.ts rewrite target for /api/*): NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
